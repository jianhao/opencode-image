{
  "name": "opencode-image",
  "version": "2.0.0",
  "description": "Image generation and editing tools for opencode (v2 plugin API), with inline rendering in the conversation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "image",
    "image-generation",
    "gpt-image"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianhao/opencode-image.git"
  },
  "homepage": "https://github.com/jianhao/opencode-image#readme",
  "bugs": {
    "url": "https://github.com/jianhao/opencode-image/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "next"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --target=node --format=esm --external sharp --external @opencode/plugin --external effect --outfile=dist/index.js",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test",
    "release": "npm publish && rm -rf ~/.cache/opencode/packages/opencode-image*",
    "release:legacy": "npm version patch && npm publish --tag latest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.27",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.27",
    "@types/node": "^24.12.2",
    "effect": "4.0.1",
    "typescript": "^5.8.2"
  },
  "bin": {
    "opencode-image": "bin/cli.js"
  }
}
