{
  "name": "opencode-image",
  "version": "0.1.3",
  "description": "Image generation and editing tools for opencode, with inline rendering in the conversation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "image",
    "image-generation",
    "gpt-image"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianhao/opencode-image.git"
  },
  "homepage": "https://github.com/jianhao/opencode-image#readme",
  "bugs": {
    "url": "https://github.com/jianhao/opencode-image/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --target=node --format=esm --external sharp --external @opencode-ai/plugin --outfile=dist/index.js",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test",
    "release": "npm version patch && npm publish && rm -rf ~/.cache/opencode/packages/opencode-image*"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2"
  },
  "bin": {
    "opencode-image": "./bin/cli.js"
  }
}
